<?xml version="1.0" encoding="UTF-8"?>
<!-- cyclone_laptop2_optitrack.xml — DDS para el optitrack_client en LAPTOP2 (~/cyclone_optitrack.xml).
     laptop2 tiene varias interfaces (ASUS_38 192.168.0.152, Tailscale 100.x, docker 172.17.x). Por
     defecto Cyclone elige una sola y puede elegir la equivocada -> aqui se FIJA la de ASUS_38 y se
     descubre por unicast hacia el Orin (192.168.0.151), esquivando el multicast WiFi bloqueado.
     Lanzar el cliente en laptop2 con:
       export ROS_DOMAIN_ID=0
       export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
       export CYCLONEDDS_URI=file://$HOME/cyclone_optitrack.xml
       ros2 run optitrack_client optitrack_client -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces><NetworkInterface address="192.168.0.152" priority="default" multicast="true"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="192.168.0.151"/>  <!-- Orin en ASUS_38 -->
        <Peer address="127.0.0.1"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
